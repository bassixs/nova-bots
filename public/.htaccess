RewriteEngine On
# One indexable home URL. Keep inbound query parameters, including UTM values.
RewriteRule ^(index\.html|services/max-bots(?:/index\.html|/)?)$ https://nova-bots.ru/ [R=301,L,NC]
RewriteCond %{HTTP_HOST} !^nova-bots\.ru$ [NC]
RewriteRule ^ https://nova-bots.ru%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://nova-bots.ru%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest

# Revalidate HTML so updated pages do not load cached scripts from older builds.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
